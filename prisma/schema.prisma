datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentType {
  SHORT_VIDEO
  SHORT_FILM
  MOVIE
  DOCUMENTARY
  OTHER
}

enum GenerationStatus {
  DRAFT
  QUEUED
  STARTING_BROWSER
  CHECKING_ACCOUNT
  OPENING_FLOW
  SUBMITTING
  GENERATING
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_USER_ACTION
  CANCELLED
}

enum VideoAssetStatus {
  PROCESSING
  READY
  FAILED
}

enum GoogleAccountStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  ERROR
  DISABLED
}

enum AccountLockStatus {
  AVAILABLE
  IN_USE
  DISABLED
}

model Project {
  id          String       @id @default(cuid())
  ownerId     String? // null only for data created before auth existed (claimed by the first admin)
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  contentType ContentType  @default(SHORT_VIDEO)
  topic       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contents    Content[]
  generations Generation[]
  videoAssets VideoAsset[]
  sequences   Sequence[]

  @@index([ownerId])
}

model Content {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  concept     String       @db.Text
  script      String       @db.Text
  videoPrompt String       @db.Text
  description String?      @db.Text
  language    String       @default("vi")
  style       String       @default("Cinematic")
  duration    String       @default("8s")
  aspectRatio String       @default("9:16")
  tags        String       @default("[]") // JSON string of tags array
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]
  sequences   Sequence[]
}

model GoogleAccount {
  id                   String              @id @default(cuid())
  ownerId              String? // null only for data created before auth existed (claimed by the first admin)
  owner                User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String // "Google Pro A", "Google Pro B"
  label                String // "Tài khoản 1 (Chính)"
  profileDir           String              @unique // Relative folder in browser-profiles/ e.g. "account-a"
  email                String? // Google email of this Flow account (pre-filled on the Google sign-in page when connecting)
  status               GoogleAccountStatus @default(NOT_CONNECTED)
  lockStatus           AccountLockStatus   @default(AVAILABLE)
  lastKnownFlowCredits Int? // Last read visible Flow credits from UI
  lastCreditCheckAt    DateTime?
  lastConnectedAt      DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  generations          Generation[]

  @@index([ownerId])
}

model Generation {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentId          String?
  content            Content?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  googleAccountId    String?
  googleAccount      GoogleAccount?    @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  prompt             String            @db.Text
  model              String            @default("Veo 3.1 Fast")
  aspectRatio        String            @default("9:16") // "16:9", "9:16", "1:1"
  duration           String            @default("8s") // "8s", "15s", "30s", "60s"
  status             GenerationStatus  @default(DRAFT)
  generationMethod   String            @default("AUTO") // "AUTO" | "MANUAL"
  provider           String            @default("GOOGLE_FLOW")
  flowCreditEstimate Int?              @default(20)
  flowProjectId      String?
  errorMessage       String?           @db.Text
  idempotencyKey     String?           @unique
  sequenceId         String?
  sequence           Sequence?         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sceneIndex         Int? // 0-based position inside the sequence
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  completedAt        DateTime?
  videoAsset         VideoAsset?
  events             GenerationEvent[]
}

model GenerationEvent {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  type         String // QUEUED, BROWSER_STARTED, ACCOUNT_CHECKED, FLOW_OPENED, SUBMITTED, GENERATING, DOWNLOAD_STARTED, DOWNLOAD_COMPLETED, PROCESSING, COMPLETED, FAILED
  message      String
  createdAt    DateTime   @default(now())
}

model VideoAsset {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationId     String?          @unique
  generation       Generation?      @relation(fields: [generationId], references: [id], onDelete: SetNull)
  filename         String
  storageKey       String // Path relative to storage root
  mimeType         String           @default("video/mp4")
  fileSize         Int // Bytes
  duration         Float? // Seconds
  width            Int? // Resolution width
  height           Int? // Resolution height
  thumbnailKey     String? // Thumbnail path relative to storage root
  status           VideoAssetStatus @default(READY)
  source           String           @default("FLOW_AUTOMATION") // "FLOW_AUTOMATION" | "MANUAL"
  providerMetadata String?          @db.Text
  sequenceId       String?          @unique // set only on the final stitched video of a Sequence
  sequence         Sequence?        @relation("SequenceFinal", fields: [sequenceId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
}

enum SequenceStatus {
  PLANNED
  RUNNING
  ASSEMBLING
  COMPLETED
  NEEDS_USER_ACTION
}

// A long video made of several independent Flow clips stitched together with ffmpeg
model Sequence {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentId          String?
  content            Content?       @relation(fields: [contentId], references: [id], onDelete: SetNull)
  googleAccountId    String?
  title              String
  brief              String         @db.Text
  styleBible         String         @db.Text // shared look/character description prepended to every scene prompt
  model              String         @default("Veo 3.1 Fast")
  aspectRatio        String         @default("9:16")
  clipSeconds        Int            @default(8)
  totalDuration      Int            @default(32) // target seconds
  transition         String         @default("CUT") // "CUT" | "CROSSFADE"
  continuity         String         @default("INDEPENDENT") // "INDEPENDENT" | "LAST_FRAME" (scene N starts from the last frame of scene N-1)
  referenceImageKeys String         @default("[]") // JSON array (max 3) of storage keys: product/character photos attached to scenes as Flow "Ingredients"
  caption            String?        @db.Text // social caption suggested for the final video (used by the publish step)
  language           String         @default("vi") // spoken words / on-screen text language passed to Flow
  genre              String? // genre template key (lib/content/genres.ts) the script was written with
  tags               String         @default("[]") // JSON array of hashtags/keywords
  status             SequenceStatus @default(PLANNED)
  errorMessage       String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  scenes             Generation[]
  finalVideo         VideoAsset?    @relation("SequenceFinal")
  topic              Topic?
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique // stored lower-cased
  name           String
  passwordHash   String? // argon2id (PHC string); null for accounts that only sign in with Google
  role           UserRole        @default(USER)
  disabled       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastLoginAt    DateTime?
  projects       Project[]
  googleAccounts GoogleAccount[]
  refreshTokens  RefreshToken[]
  oauthAccounts  OAuthAccount[]
  channels       Channel[]
}

// Opaque refresh tokens, rotated on every use. All tokens issued from one login share a familyId; presenting an already
// rotated token (outside a short grace window) means it was stolen, so the whole family is revoked.
model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId        String
  tokenHash       String    @unique // sha256(token); the raw token only ever lives in the user's cookie
  createdAt       DateTime  @default(now())
  expiresAt       DateTime // idle timeout: a token not rotated before this date is dead
  familyExpiresAt DateTime // absolute session lifetime, copied from the first token of the family
  rotatedAt       DateTime? // set when exchanged for a successor
  revokedAt       DateTime?
  revokeReason    String?
  userAgent       String?
  ip              String?

  @@index([familyId])
  @@index([userId])
}

// External identities linked to a user (Google sign-in). providerAccountId = the provider's stable subject id ("sub").
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google"
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A channel = identity (look, language, hashtags, reference images) + automation settings. Replaces the JSON presets.
model Channel {
  id                 String @id @default(cuid())
  ownerId            String
  owner              User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  styleBible         String @default("") @db.Text
  language           String @default("vi")
  aspectRatio        String @default("9:16")
  model              String @default("Veo 3.1 Fast")
  clipSeconds        Int    @default(10)
  continuity         String @default("FLOW_AGENT")
  transition         String @default("CUT")
  hashtags           String @default("[]") // JSON string[]
  referenceImageKeys String @default("[]") // JSON string[] (max 3)

  // --- automation ---
  automationEnabled Boolean   @default(false)
  niche             String    @default("") @db.Text // what the channel is about: guides research + scripts
  genres            String    @default("[]") // JSON genre keys allowed for this channel
  durations         String    @default("[30]") // JSON seconds, e.g. [30, 60]
  videosPerDay      Int       @default(1)
  reviewHours       Int       @default(12) // new topics are produced after this delay unless deleted; 0 = manual approval only
  dailyCreditBudget Int       @default(200) // Flow credits this channel may spend per day (0 = no cap)
  projectId         String? // project the videos are filed under (created on first use)
  googleAccountId   String? // preferred Google account (else any connected one of the owner)
  lastResearchAt    DateTime? // last automatic topic research run
  lastResearchNote  String?   @db.Text // outcome of that run (shown in the UI)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topics    Topic[]

  @@index([ownerId])
}

enum TopicStatus {
  SUGGESTED // waiting in the inbox; produced at autoApproveAt unless rejected
  APPROVED // ready to be produced when the channel's schedule allows
  PRODUCING // script written, video rendering
  READY // final video exists
  FAILED
  REJECTED // deleted by the user: kept so it is never suggested again
}

model Topic {
  id              String      @id @default(cuid())
  channelId       String
  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title           String
  normalizedTitle String // lower-case, accents stripped: duplicate detection
  angle           String?     @db.Text // the hook / why it is interesting
  genre           String // genre template key
  durationSec     Int
  source          String      @default("MANUAL") // MANUAL | AI_RESEARCH | API
  sourceUrls      String      @default("[]")
  score           Float?
  status          TopicStatus @default(SUGGESTED)
  autoApproveAt   DateTime?
  approvedAt      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  rejectedAt      DateTime?
  sequenceId      String?     @unique
  sequence        Sequence?   @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  errorMessage    String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([channelId, status])
  @@index([channelId, normalizedTitle])
}
