# ===== Hạ tầng (docker-compose.yml) =====
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5438/aicontentfactory?schema=public"
REDIS_URL="redis://127.0.0.1:6389"
# Nơi lưu video / ảnh tham chiếu
STORAGE_PATH="./storage"
# Hồ sơ trình duyệt giữ phiên đăng nhập Google của từng tài khoản Flow (đã nằm trong .gitignore)
BROWSER_PROFILE_PATH="./data/browser-profiles"
# ffmpeg/ffprobe (nếu không có trong PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=

# ===== Đăng nhập & phân quyền =====
# BẮT BUỘC: khoá ký JWT, >= 32 ký tự ngẫu nhiên. Tạo bằng: openssl rand -base64 48
AUTH_SECRET=
# Người đăng ký đầu tiên là ADMIN và nhận toàn bộ dữ liệu cũ. Sau đó chỉ cho đăng ký khi = true (hoặc dùng npm run user:create)
ALLOW_SIGNUP=false
# Chỉ đặt true khi chạy sau reverse proxy tin cậy (để lấy IP thật từ X-Forwarded-For cho giới hạn đăng nhập)
TRUST_PROXY=false
# Cookie Secure: tự bật khi NODE_ENV=production; đặt true nếu chạy HTTPS ở môi trường khác
AUTH_COOKIE_SECURE=false
# Đăng nhập bằng Google (tuỳ chọn). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback  (vd: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Địa chỉ gốc của web, dùng để dựng redirect URI OAuth (không lấy từ header Host của request)
APP_URL=http://localhost:3000

# ===== Google Flow (render clip) =====
FLOW_BASE_URL="https://labs.google/fx/tools/flow"
FLOW_HEADLESS=false
# Thời gian chờ Flow render (giây), cộng thêm 180 giây cho mỗi clip
FLOW_GENERATION_TIMEOUT_SEC=480
# Trần credit cho 1 video (mọi lần phê duyệt cộng lại). 0 = tắt
FLOW_MAX_CREDITS_PER_VIDEO=300
# Ngân sách credit mỗi ngày cho mỗi tài khoản (theo giờ máy). 0 = tắt. Mỗi kênh còn có ngân sách riêng.
FLOW_DAILY_CREDIT_BUDGET=0
# false = không tự bấm "Phê duyệt" kế hoạch của Flow Agent (bạn tự duyệt trong trình duyệt)
FLOW_AUTO_APPROVE=true
# Agent im lặng quá số giây này mà chưa có kế hoạch (vd: hỏi lại, chờ duyệt ảnh storyboard) thì tự trả lời "tiến hành" (tối đa FLOW_AGENT_MAX_NUDGES lần)
FLOW_AGENT_IDLE_SEC=50
FLOW_AGENT_MAX_NUDGES=3
# Chạy thử (0 credit) chờ tối đa bao lâu để Agent đưa thẻ duyệt (giây). Agent thường vẽ ảnh storyboard 2-3 phút trước
FLOW_DRYRUN_TIMEOUT_SEC=480
# Kiểm tra giao diện Flow định kỳ (giờ, 0 credit). 0 = chỉ kiểm tra hằng ngày cho tài khoản mà automation dùng. Chạy tay: npm run flow:health
FLOW_HEALTHCHECK_HOURS=0

# ===== Ghép video =====
# Cân âm lượng mọi clip về -14 LUFS khi ghép (chuẩn TikTok/Reels/Shorts). false = giữ nguyên
AUDIO_NORMALIZE=true
# true = giữ lại các clip 10s sau khi ghép (mặc định chỉ giữ video dài; clip vẫn nằm trong project Flow, khôi phục 0 credit)
KEEP_SEQUENCE_CLIPS=false

# ===== AI viết kịch bản & tìm chủ đề =====
# Key Google AI Studio (free tier đủ dùng) hoặc key OpenRouter (sk-or-…). Trống = Flow Agent tự lên kịch bản theo khung thể loại.
GEMINI_API_KEY=""
# Model chính / dự phòng khi model chính quá tải (503). gemini-2.0-flash đã bị Google tắt.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Chu kỳ bộ lập lịch trong worker (giây): tự tìm chủ đề, tự duyệt, tự sản xuất, tự đăng. 0 = tắt
AUTOMATION_TICK_SEC=60
# Webhook nhận thông báo (Slack/Discord/n8n/Make...). Để trống = tắt
AUTOMATION_WEBHOOK_URL=
# Thêm chủ đề qua /api/automation/topics không cần đăng nhập: header x-api-key = AUTOMATION_API_KEY (>= 24 ký tự),
# chạy với quyền của tài khoản AUTOMATION_OWNER_EMAIL. Để trống = chỉ người đã đăng nhập mới gọi được.
AUTOMATION_API_KEY=
AUTOMATION_OWNER_EMAIL=

# ===== Đăng bài tự động (TikTok / Facebook Page) =====
# Khoá mã hoá token mạng xã hội (32 byte base64: openssl rand -base64 32). Trống = suy ra từ AUTH_SECRET
TOKEN_ENCRYPTION_KEY=
# TikTok for Developers > app > Login Kit + Content Posting API (Direct Post), scope user.info.basic,video.publish
# Redirect URI: <APP_URL>/api/social/tiktok/callback (TikTok bắt buộc HTTPS: dùng domain thật hoặc tunnel)
# App chưa được TikTok audit chỉ đăng được chế độ riêng tư (SELF_ONLY)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta for Developers > app (Business) > Facebook Login, quyền pages_show_list, pages_read_engagement, pages_manage_posts
# Valid OAuth Redirect URI: <APP_URL>/api/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Chỉ khi app dùng "Facebook Login for Business": ID cấu hình (User access token + 3 quyền trên). Trống = Facebook Login thường
FACEBOOK_CONFIG_ID=
GRAPH_API_VERSION=v26.0
