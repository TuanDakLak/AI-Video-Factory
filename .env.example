# PostgreSQL Database connection (from docker-compose.yml on port 5438)
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5438/aicontentfactory?schema=public"

# Redis queue connection (from docker-compose.yml on port 6389)
REDIS_URL="redis://127.0.0.1:6389"

# Storage root directory for imported videos
STORAGE_PATH="./storage"

# Browser profile directory for persistent Google sessions (Safe local directory, added to .gitignore)
BROWSER_PROFILE_PATH="./data/browser-profiles"

# Google Flow canonical URL
FLOW_BASE_URL="https://labs.google/fx/tools/flow"

# Concurrency setting
MAX_CONCURRENT_FLOW_JOBS=1

# OPTIONAL: Gemini API key for automatic script/prompt generation
GEMINI_API_KEY=""

FLOW_HEADLESS=false

FLOW_GENERATION_TIMEOUT_SEC=480

# ffmpeg/ffprobe (nếu không có trong PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=

# Bảo vệ credit Flow
# Trần credit cho 1 video (mọi lần phê duyệt cộng lại). 0 = tắt
FLOW_MAX_CREDITS_PER_VIDEO=300
# Ngân sách credit mỗi ngày (theo giờ máy). 0 = tắt
FLOW_DAILY_CREDIT_BUDGET=0
# Agent im lặng quá số giây này mà chưa có kế hoạch thì tự trả lời "tự quyết định" (tối đa FLOW_AGENT_MAX_NUDGES lần)
FLOW_AGENT_IDLE_SEC=50
FLOW_AGENT_MAX_NUDGES=2

# --- Tự động hoá ---
# Kiểm tra giao diện Flow định kỳ (giờ). 0 = tắt. Hoặc chạy tay: npm run flow:health
FLOW_HEALTHCHECK_HOURS=0
# Webhook nhận thông báo (Slack/Discord/n8n/Make...). Để trống = tắt
AUTOMATION_WEBHOOK_URL=
# Gọi /api/automation/videos không cần đăng nhập: header x-api-key = AUTOMATION_API_KEY (>= 24 ký tự),
# chạy với quyền của tài khoản AUTOMATION_OWNER_EMAIL. Để trống = chỉ người đã đăng nhập mới gọi được.
AUTOMATION_API_KEY=
AUTOMATION_OWNER_EMAIL=

# --- Veo API dự phòng (tính theo USD, chỉ tính clip thành công) ---
# Dùng GEMINI_API_KEY ở trên (cần bật thanh toán) hoặc đặt riêng VEO_API_KEY
VEO_API_KEY=
VEO_API_MODEL=veo-3.1-fast-generate-preview
VEO_API_USD_PER_SECOND=0.10
VEO_API_MAX_USD_PER_VIDEO=15
VEO_API_DAILY_USD_BUDGET=0
# true = khi Flow lỗi TRƯỚC khi phê duyệt (chưa tốn credit) thì tự chạy lại bằng Veo API
VIDEO_FALLBACK_TO_API=false

# --- Đăng nhập & phân quyền ---
# BẮT BUỘC: khoá ký JWT, >= 32 ký tự ngẫu nhiên. Tạo bằng: openssl rand -base64 48
AUTH_SECRET=
# Người đăng ký đầu tiên là ADMIN và nhận toàn bộ dữ liệu cũ. Sau đó chỉ cho đăng ký khi = true (hoặc dùng npm run user:create)
ALLOW_SIGNUP=false
# Chỉ đặt true khi chạy sau reverse proxy tin cậy (để lấy IP thật từ X-Forwarded-For cho giới hạn đăng nhập)
TRUST_PROXY=false
# Cookie Secure: tự bật khi NODE_ENV=production; đặt true nếu chạy HTTPS ở môi trường khác
AUTH_COOKIE_SECURE=false
# Đăng nhập bằng Google (tuỳ chọn). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback  (vd: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Địa chỉ gốc của web, dùng để dựng redirect URI cho Google (không lấy từ header Host của request)
APP_URL=http://localhost:3000

# --- AI viết kịch bản & tìm chủ đề ---
# GEMINI_API_KEY ở trên: key Google AI Studio (free tier đủ dùng) hoặc key OpenRouter (sk-or-…)
# Model chính / dự phòng khi model chính quá tải (503). gemini-2.0-flash đã bị Google tắt.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Chu kỳ bộ lập lịch trong worker (giây): tự duyệt chủ đề, tự tìm chủ đề, tự sản xuất. 0 = tắt
AUTOMATION_TICK_SEC=60

# Cân âm lượng mọi clip về -14 LUFS khi ghép (chuẩn TikTok/Reels/Shorts). false = giữ nguyên
AUDIO_NORMALIZE=true
